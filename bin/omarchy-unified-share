#!/usr/bin/env bash
set -euo pipefail

self_path=$(realpath "$0")
omarchy_settings=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/unified-share.json

find_core() {
  if command -v unified-share >/dev/null 2>&1; then
    command -v unified-share
    return
  fi
  local candidate
  for candidate in \
    "$HOME/Projects/unified-share/target/release/unified-share" \
    "$HOME/Projects/unified-share/target/debug/unified-share"; do
    [[ -x $candidate ]] && { printf '%s\n' "$candidate"; return; }
  done
  return 1
}

notify() {
  omarchy-notification-send -g "" "$@" >/dev/null 2>&1 || true
}

read_omarchy_setting() {
  local key=$1 fallback=$2 minimum=$3 maximum=$4 value
  value=$(jq -er --arg key "$key" '.[$key] | numbers | floor' "$omarchy_settings" 2>/dev/null || printf '%s' "$fallback")
  if ((value < minimum || value > maximum)); then
    value=$fallback
  fi
  printf '%s\n' "$value"
}

write_omarchy_setting() {
  local key=$1 value=$2 settings_dir temporary
  settings_dir=$(dirname "$omarchy_settings")
  mkdir -p -m 700 "$settings_dir"
  temporary=$(mktemp --tmpdir="$settings_dir" unified-share.XXXXXX.json)
  if [[ -s $omarchy_settings ]]; then
    jq --arg key "$key" --argjson value "$value" '.[$key] = $value' "$omarchy_settings" >"$temporary"
  else
    jq -n --arg key "$key" --argjson value "$value" '{($key): $value}' >"$temporary"
  fi
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$omarchy_settings"
}

acquire_ui_lock() {
  local runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/unified-share
  mkdir -p -m 700 "$runtime_dir"
  exec 9>"$runtime_dir/omarchy-ui.lock"
  if ! flock -n 9; then
    notify "Sharing is already open" "Finish or cancel the current sharing window first."
    exit 0
  fi
}

pick_paths() {
  local mode=$1 path picked status=0
  shift
  if (($# > 0)); then
    for path in "$@"; do
      realpath -- "$path"
    done
    return
  fi
  case "$mode" in
    clipboard)
      local cache_dir clipboard_file
      cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/unified-share/clipboard
      mkdir -p "$cache_dir"
      find "$cache_dir" -type f -mtime +1 -delete 2>/dev/null || true
      clipboard_file=$(mktemp --tmpdir="$cache_dir" clipboard.XXXXXX.txt)
      wl-paste >"$clipboard_file"
      printf '%s\n' "$clipboard_file"
      ;;
    folder)
      picked=$(omarchy-file-select --title "Share folder" --directory) || status=$?
      ((status <= 1)) || return "$status"
      [[ -n $picked ]] && printf '%s\n' "$picked"
      ;;
    *)
      picked=$(omarchy-file-select --title "Share files" --multiple) || status=$?
      ((status <= 1)) || return "$status"
      [[ -n $picked ]] && printf '%s\n' "$picked"
      ;;
  esac
}

stage_directories() {
  local route=$1 path cache_dir archive
  shift
  if [[ $route == local-send ]]; then
    printf '%s\n' "$@"
    return
  fi
  cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/unified-share/staged
  mkdir -p "$cache_dir"
  find "$cache_dir" -type f -mtime +1 -delete 2>/dev/null || true
  for path in "$@"; do
    if [[ -d $path ]]; then
      archive=$(mktemp --tmpdir="$cache_dir" "$(basename "$path").XXXXXX.zip")
      rm -f -- "$archive"
      (cd "$(dirname "$path")" && zip -qr "$archive" "$(basename "$path")")
      printf '%s\n' "$archive"
    else
      printf '%s\n' "$path"
    fi
  done
}

send_transfer() {
  local route=$1 device_id=$2 device_name=$3
  shift 3
  local core result status=0 message url transfer_id qr_dir qr_path link_timeout
  core=$(find_core) || { notify "Unified Share unavailable" "Build or install the Unified Share core first."; exit 1; }
  local -a paths=("$@") staged share_args
  mapfile -t staged < <(stage_directories "$route" "${paths[@]}")
  share_args=(share --json --via "$route")
  if [[ $route == quick-share ]]; then
    share_args+=(--device "$device_id" --device-name "$device_name")
  elif [[ $route == browser ]]; then
    link_timeout=$(read_omarchy_setting link_timeout_seconds 600 30 86400)
    share_args+=(--timeout-seconds "$link_timeout")
  fi
  result=$("$core" "${share_args[@]}" "${staged[@]}" 2> >(
    while IFS= read -r line; do
      if [[ $line == "Quick Share confirmation code: "* ]]; then
        notify "Confirm Quick Share" "Code ${line#Quick Share confirmation code: }"
      fi
    done
  )) || status=$?
  if ((status != 0)); then
    notify "Share failed" "${result:-The recipient did not complete the transfer.}"
    exit "$status"
  fi
  message=$(jq -r '.message // "Transfer completed"' <<<"$result")
  url=$(jq -r '.url // empty' <<<"$result")
  if [[ -n $url ]]; then
    printf '%s' "$url" | wl-copy
    transfer_id=$(jq -r '.transfer_id // empty' <<<"$result")
    if command -v qrencode >/dev/null 2>&1 && [[ -n $transfer_id ]]; then
      qr_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/unified-share/qr
      mkdir -p -m 700 "$qr_dir"
      find "$qr_dir" -type f -mmin +1440 -delete 2>/dev/null || true
      qr_path=$qr_dir/$transfer_id.png
      qrencode -m 2 -s 8 -o "$qr_path" -- "$url"
      chmod 600 "$qr_path"
      notify "Scan to receive" "Private Wi-Fi link copied · click the QR code to enlarge" \
        -t 30000 --image "$qr_path" --exec "$(printf 'imv %q' "$qr_path")"
    else
      notify "Sharing link copied" "Paste it on a device connected to this Wi-Fi."
    fi
  else
    notify "Shared" "$message"
  fi
}

choose_quick_share_device() {
  local core discovery selection label device_id device_name index discovery_seconds
  local -a paths=("$@") options device_ids device_names option_labels
  core=$(find_core) || { notify "Unified Share unavailable" "Build or install the Unified Share core first."; exit 1; }

  while true; do
    notify "Quick Share" "Looking for nearby Android and Windows devices…"
    discovery_seconds=$(read_omarchy_setting discovery_seconds 3 1 15)
    discovery=$("$core" discover --timeout-seconds "$discovery_seconds" --json 2>/dev/null || printf '%s' '{"devices":[]}' )
    options=()
    device_ids=()
    device_names=()
    option_labels=()

    while IFS=$'\t' read -r device_id device_name; do
      [[ -n $device_id ]] || continue
      if [[ $device_name == Android_* ]]; then
        label="Android device"
      else
        label=$device_name
      fi
      options+=("󰀲"$'\t'"$label"$'\t'"Quick Share · $device_name")
      option_labels+=("$label")
      device_ids+=("$device_id")
      device_names+=("$device_name")
    done < <(jq -r '.devices[]? | [.id, .name] | @tsv' <<<"$discovery")

    if ((${#device_ids[@]} == 0)); then
      selection=$(omarchy-menu-select "No nearby devices found" \
        "󰑐"$'\t'"Scan again"$'\t'"Make the receiving device visible, then retry" \
        "󰐲"$'\t'"Show QR code"$'\t'"Bypasses Quick Share visibility and contacts" \
        ""$'\t'"Use LocalSend"$'\t'"Compatibility fallback" \
        "󰁍"$'\t'"Back"$'\t'"Choose another sharing method" \
        -- --width 590) || return 1
      case ${selection%%$'\t'*} in
        "Scan again") continue ;;
        "Show QR code")
          send_transfer browser "" "" "${paths[@]}"
          return
          ;;
        "Use LocalSend")
          systemd-run --user --quiet --collect \
            "$self_path" send local-send "" "" "${paths[@]}"
          return
          ;;
        *) return 1 ;;
      esac
    fi

    selection=$(omarchy-menu-select "Choose a nearby device" "${options[@]}" \
      "󰑐"$'\t'"Scan again"$'\t'"Refresh the nearby-device list" \
      "󰁍"$'\t'"Back"$'\t'"Choose another sharing method" \
      -- --width 590) || return 1
    label=${selection%%$'\t'*}
    [[ $label == "Scan again" ]] && continue
    [[ $label == "Back" ]] && return 1

    for index in "${!option_labels[@]}"; do
      if [[ ${option_labels[$index]} == "$label" ]]; then
        systemd-run --user --quiet --collect \
          "$self_path" send quick-share "${device_ids[$index]}" "${device_names[$index]}" "${paths[@]}"
        return
      fi
    done
    return 1
  done
}

choose_route() {
  local mode=$1
  shift
  local selection label count_label
  local -a paths=("$@")
  if ((${#paths[@]} == 1)); then
    count_label="1 item"
  else
    count_label="${#paths[@]} items"
  fi

  while true; do
    selection=$(omarchy-menu-select "Share $count_label" \
      "󰀲"$'\t'"Quick Share device"$'\t'"Nearby Android or Windows" \
      "󰐲"$'\t'"QR code or private link"$'\t'"iPhone, Android, Mac, Windows, or Linux" \
      ""$'\t'"LocalSend device"$'\t'"Compatibility fallback" \
      -- --width 590) || exit 0
    label=${selection%%$'\t'*}
    case $label in
      "Quick Share device")
        choose_quick_share_device "${paths[@]}" && return
        ;;
      "QR code or private link")
        send_transfer browser "" "" "${paths[@]}"
        return
        ;;
      "LocalSend device")
        systemd-run --user --quiet --collect \
          "$self_path" send local-send "" "" "${paths[@]}"
        return
        ;;
    esac
  done
}

show_history() {
  local core payload selection
  local -a options
  core=$(find_core) || exit 1
  payload=$("$core" history --limit 20 --json)
  while IFS=$'\t' read -r outcome target count message; do
    options+=("󰋚"$'\t'"$target · $count item(s)"$'\t'"$outcome · $message")
  done < <(jq -r '.entries[]? | [.outcome, .target, .item_count, .message] | @tsv' <<<"$payload")
  options+=("󰆴"$'\t'"Clear history"$'\t'"Remove local transfer records")
  selection=$(omarchy-menu-select "Transfer history" "${options[@]}" -- --width 620) || exit 0
  if [[ ${selection%%$'\t'*} == "Clear history" ]]; then
    "$core" history --clear --json >/dev/null
    notify "Transfer history" "History cleared"
  fi
}

set_device_name() {
  local core current value
  core=$(find_core) || exit 1
  current=$("$core" config --json | jq -r '.device_name')
  value=$(omarchy-menu-input "Device name (currently: $current)" --width 520) || exit 0
  "$core" config --device-name "$value" --json >/dev/null
  notify "Unified Share" "This computer now appears as $value"
}

show_settings() {
  local selection label discovery_seconds link_timeout link_label
  while true; do
    discovery_seconds=$(read_omarchy_setting discovery_seconds 3 1 15)
    link_timeout=$(read_omarchy_setting link_timeout_seconds 600 30 86400)
    if ((link_timeout % 3600 == 0)); then
      link_label="$((link_timeout / 3600)) hour(s)"
    else
      link_label="$((link_timeout / 60)) minutes"
    fi
    selection=$(omarchy-menu-select "Sharing preferences" \
      "󰛋"$'\t'"Computer name"$'\t'"How this computer appears to nearby devices" \
      "󰑐"$'\t'"Quick Share scan"$'\t'"${discovery_seconds} seconds" \
      "󰔚"$'\t'"QR/link lifetime"$'\t'"$link_label" \
      -- --width 590) || return
    label=${selection%%$'\t'*}
    case $label in
      "Computer name") set_device_name ;;
      "Quick Share scan")
        selection=$(omarchy-menu-select "Quick Share scan time" \
          "󰔛"$'\t'"3 seconds"$'\t'"Fast" \
          "󰔜"$'\t'"5 seconds"$'\t'"Balanced" \
          "󰔝"$'\t'"8 seconds"$'\t'"More time to discover devices" \
          -- --width 560) || continue
        write_omarchy_setting discovery_seconds "${selection%% *}"
        ;;
      "QR/link lifetime")
        selection=$(omarchy-menu-select "Private link lifetime" \
          "󰔛"$'\t'"10 minutes"$'\t'"Recommended for quick transfers" \
          "󰔜"$'\t'"30 minutes"$'\t'"More time for several devices" \
          "󰔝"$'\t'"1 hour"$'\t'"Keep the link available longer" \
          -- --width 580) || continue
        case ${selection%%$'\t'*} in
          "10 minutes") write_omarchy_setting link_timeout_seconds 600 ;;
          "30 minutes") write_omarchy_setting link_timeout_seconds 1800 ;;
          "1 hour") write_omarchy_setting link_timeout_seconds 3600 ;;
        esac
        ;;
    esac
  done
}

command_name=${1:-share}
shift || true
case "$command_name" in
  share)
    acquire_ui_lock
    mode=${1:-file}
    shift || true
    mapfile -t selected_paths < <(pick_paths "$mode" "$@")
    ((${#selected_paths[@]} > 0)) || exit 0
    choose_route "$mode" "${selected_paths[@]}"
    ;;
  send)
    send_transfer "$@"
    ;;
  history)
    acquire_ui_lock
    show_history
    ;;
  device-name)
    acquire_ui_lock
    set_device_name
    ;;
  settings)
    acquire_ui_lock
    show_settings
    ;;
  *)
    printf 'Usage: %s <share|send|history|device-name|settings>\n' "$0" >&2
    exit 2
    ;;
esac
