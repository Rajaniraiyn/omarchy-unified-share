#!/usr/bin/env bash
set -euo pipefail

find_core() {
  if command -v unified-share >/dev/null 2>&1; then
    command -v unified-share
    return
  fi

  local candidate
  for candidate in \
    "$HOME/Projects/unified-share/target/release/unified-share" \
    "$HOME/Projects/unified-share/target/debug/unified-share"; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  return 1
}

core=$(find_core || true)
command_name=${1:-status}
shift || true

if [[ -z $core ]]; then
  printf '%s\n' '{"schema_version":1,"version":"not installed","adapters":[]}'
  exit 2
fi

case "$command_name" in
  status)
    exec "$core" status --json
    ;;
  history)
    exec "$core" history --limit 4 --json
    ;;
  discover)
    exec "$core" discover --timeout-seconds 8 --json
    ;;
  share-file|share-folder)
    route=${1:-browser}
    device_id=${2:-}
    device_name=${3:-Quick Share device}
    case "$route" in
      browser|localsend|auto|quick-share) ;;
      *)
        printf '%s\n' '{"schema_version":1,"ok":false,"message":"Unknown sharing route"}'
        exit 2
        ;;
    esac

    if [[ $command_name == share-folder ]]; then
      picker_args=(--title "Share folder" --directory)
    else
      picker_args=(--title "Share files" --multiple)
    fi

    picked=$(omarchy-file-select "${picker_args[@]}") || picker_status=$?
    if ((${picker_status:-0} > 1)); then
      printf '%s\n' '{"schema_version":1,"ok":false,"message":"The file picker could not open"}'
      exit 1
    fi
    [[ -n $picked ]] || exit 0
    readarray -t paths <<<"$picked"
    printf '%s\n' '{"event":"picker_complete"}'
    share_args=(share --json --via "$route")
    if [[ $route == quick-share ]]; then
      [[ -n $device_id ]] || exit 2
      share_args+=(--device "$device_id" --device-name "$device_name")
    fi
    exec "$core" "${share_args[@]}" "${paths[@]}"
    ;;
  share-clipboard)
    route=${1:-browser}
    device_id=${2:-}
    device_name=${3:-Quick Share device}
    case "$route" in
      browser|localsend|auto|quick-share) ;;
      *)
        printf '%s\n' '{"schema_version":1,"ok":false,"message":"Unknown sharing route"}'
        exit 2
        ;;
    esac

    cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/unified-share/clipboard
    mkdir -p "$cache_dir"
    find "$cache_dir" -type f -mtime +1 -delete 2>/dev/null || true
    clipboard_file=$(mktemp --tmpdir="$cache_dir" clipboard.XXXXXX.txt)
    wl-paste >"$clipboard_file"
    share_args=(share --json --via "$route")
    if [[ $route == quick-share ]]; then
      [[ -n $device_id ]] || exit 2
      share_args+=(--device "$device_id" --device-name "$device_name")
    fi
    exec "$core" "${share_args[@]}" "$clipboard_file"
    ;;
  qr-code)
    url=${1:-}
    transfer_id=${2:-}
    [[ -n $url && $transfer_id =~ ^[[:alnum:]-]+$ ]] || exit 2
    command -v qrencode >/dev/null 2>&1 || exit 3
    qr_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/unified-share/qr
    mkdir -p -m 700 "$qr_dir"
    find "$qr_dir" -type f -mmin +1440 -delete 2>/dev/null || true
    qr_path=$qr_dir/$transfer_id.png
    qrencode -m 2 -s 6 -o "$qr_path" -- "$url"
    chmod 600 "$qr_path"
    printf '%s\n' "$qr_path"
    ;;
  copy-link)
    url=${1:-}
    [[ -n $url ]] || exit 2
    printf '%s' "$url" | wl-copy
    ;;
  stop-transfer)
    transfer_id=${1:-}
    [[ $transfer_id =~ ^[[:alnum:]-]+$ ]] || exit 2
    "$core" stop --json "$transfer_id"
    qr_path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/unified-share/qr/$transfer_id.png
    rm -f -- "$qr_path"
    ;;
  *)
    printf 'Unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
